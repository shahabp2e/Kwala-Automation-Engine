# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info

# ── Blockchain Network ────────────────────────────────────────────────────────
RPC_URL=https://your-rpc-endpoint.example.com
CHAIN_ID=1905
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# ── Deployment Gas ────────────────────────────────────────────────────────────
GAS_PRICE=1000000000
GAS_LIMIT=3000000

# ── Kwala API ─────────────────────────────────────────────────────────────────
STATUS_API_BASE=https://your-api-base/workflow
VERIFY_URL=https://your-api-base/workflow/verify
RECHARGE_BASE=https://your-api-base/user/recharge
STATUS_CHECK_INTERVAL=5000
MAX_STATUS_CHECKS=60

# ── Wallet (NEVER commit the real value) ─────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Paths (optional — defaults shown) ────────────────────────────────────────
# YAML_DIR=../data/yaml_workflows
# DB_PATH=../data/kwala.db
